# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets / local config
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors / OS
.idea/
.vscode/
Thumbs.db
Desktop.ini

# Data (large, regenerable from the vault + FRED)
/data/

# Tekst rada i uputstva za asistenta se ne objavljuju (ostaju samo lokalno)
/rad/
/CLAUDE.md

# Step logs written by scripts/run_all.ps1
/logs/

# Run output (large, regenerable by re-running the pipeline). Only the
# reported run's artefacts and provenance are published; the forecast tables
# (4.2 GB) and per-horizon daily losses (1.3 GB each, over GitHub's 100 MB
# file limit) stay local, as do the superseded runs.
/results/*
!/results/run_v3/
/results/run_v3/*
!/results/run_v3/manifest.json
!/results/run_v3/regime_boundary.json
!/results/run_v3/ttm_contamination_check.json
!/results/run_v3/report/
/results/run_v3/report/daily_losses_*.parquet
/results/run_v3/report/**/*.log
/results/run_v3/report/**/*.parquet
