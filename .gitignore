rad/*.aux
rad/*.bbl
rad/*.bcf
rad/*.blg
rad/*.out
rad/*.run.xml
rad/*.toc

# Run output (large, regenerable by re-running the pipeline): forecast
# tables, per-horizon daily losses and the report artefacts. 16 GB at the
# time of writing -- the provenance that matters (manifest.json with the
# git sha, panel hash and package versions) is regenerated with the run.
/results/
